{
  "name": "@valfuse-node/core",
  "version": "0.1.0",
  "description": "[DEPRECATED] Orchestration layer for valfuse-node — use @valfuse-node/form for schema/validation and @valfuse-node/localization for i18n",
  "license": "MIT",
  "sideEffects": false,
  "keywords": ["validation", "schema", "form", "typescript", "valfuse"],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@vitest/coverage-v8": "latest",
    "vitest": "latest"
  }
}