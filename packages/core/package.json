{
  "name": "@valfuse-node/core",
  "version": "0.3.0",
  "description": "Umbrella entry point for valfuse-node — re-exports form domain, localization runtime, and React/Vue adapters so a single install gives you the full library.",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "validation",
    "schema",
    "form",
    "i18n",
    "localization",
    "react",
    "vue",
    "typescript",
    "valfuse"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@valfuse-node/form": "*",
    "@valfuse-node/localization": "*",
    "@valfuse-node/react": "*",
    "@valfuse-node/vue": "*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "4.1.6",
    "react": "^18",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
