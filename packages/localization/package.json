{
  "name": "@valfuse-node/localization",
  "version": "0.3.1",
  "description": "Localization generation engine — compiler, CLI, validator and runtime for @valfuse-node",
  "license": "MIT",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "json",
    "codegen",
    "cli",
    "valfuse"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "bin": {
    "valfuse-localization": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli/index.js",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "yaml": "^2.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpinnz/valfuse-node.git",
    "directory": "packages/localization"
  },
  "homepage": "https://github.com/alpinnz/valfuse-node#readme",
  "bugs": {
    "url": "https://github.com/alpinnz/valfuse-node/issues"
  }
}
