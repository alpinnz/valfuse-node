{
  "name": "@valfuse-node/adapter-react",
  "version": "0.0.1",
  "description": "React Hook Form adapter for valfuse-node — useValfuseForm with native schema validation",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "validation",
    "schema",
    "form",
    "react",
    "react-hook-form",
    "typescript",
    "valfuse",
    "adapter"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external react-dom --external react-hook-form --external @valfuse-node/core",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-dom --external react-hook-form --external @valfuse-node/core",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@valfuse-node/core": "^0.0.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7",
    "vitest": "latest"
  }
}
