{
  "name": "@valfuse-node/form",
  "version": "0.3.6",
  "description": "Framework-agnostic form-state primitives",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "form",
    "typescript",
    "valfuse"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @valfuse-node/validation",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external @valfuse-node/validation",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@valfuse-node/validation": "*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpinnz/valfuse-node.git",
    "directory": "packages/form"
  },
  "homepage": "https://github.com/alpinnz/valfuse-node#readme",
  "bugs": {
    "url": "https://github.com/alpinnz/valfuse-node/issues"
  }
}
