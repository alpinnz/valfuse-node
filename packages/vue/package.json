{
  "name": "@valfuse-node/vue",
  "version": "0.3.1",
  "description": "Vue adapter for valfuse-node — useValfuseForm composable",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "validation",
    "schema",
    "form",
    "vue",
    "vue3",
    "composable",
    "typescript",
    "valfuse"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external vue --external @valfuse-node/form",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external vue --external @valfuse-node/form",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@valfuse-node/form": "*"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.10",
    "vitest": "4.1.11",
    "vue": "^3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpinnz/valfuse-node.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/alpinnz/valfuse-node#readme",
  "bugs": {
    "url": "https://github.com/alpinnz/valfuse-node/issues"
  }
}
