{
  "name": "valfuse-node",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "publish:core": "npm publish --workspace=packages/core",
    "publish:localization": "npm publish --workspace=packages/localization",
    "publish:react": "npm publish --workspace=packages/react",
    "publish:vue": "npm publish --workspace=packages/vue",
    "publish:form": "npm publish --workspace=packages/form",
    "publish:all": "npm run publish:core && npm run publish:localization && npm run publish:react && npm run publish:vue && npm run publish:form",
    "example:localization:generate": "npm run localization:generate --workspace=packages/examples/react-example",
    "example:localization:watch": "npm run localization:watch --workspace=packages/examples/react-example",
    "example:localization:validate": "npm run localization:validate --workspace=packages/examples/react-example",
    "dev:react": "npm run dev --workspace=packages/examples/react-example",
    "dev:vue": "npm run dev --workspace=packages/examples/vue-example",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "turbo test -- --coverage",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.4.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
